generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  COMPANY_OWNER
  COMPANY_ADMIN
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  FLEXI_JOB
  STUDENT
  CONTRACTOR
  OTHER
}

model Company {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  vatNumber   String?
  email       String?
  phone       String?
  addressLine String?
  postalCode  String?
  city        String?
  countryCode String   @default("BE")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  iban                   String?
  bic                    String?
  invoicePrefix          String  @default("INV")
  defaultPaymentTermDays Int     @default(30)
  defaultVatRate         Decimal @default(21.00) @db.Decimal(5, 2)

  invoices         Invoice[]
  invoiceSequences InvoiceSequence[]

  users              User[]
  customers          Customer[]
  employees          Employee[]
  workOrders         WorkOrder[]
  workOrderSequences WorkOrderSequence[]

  @@map("companies")
}

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  name          String
  contactPerson String?
  email         String?
  phone         String?
  vatNumber     String?
  addressLine   String?
  postalCode    String?
  city          String?
  countryCode   String   @default("BE")
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]
  invoices   Invoice[]

  @@index([companyId, isActive])
  @@index([companyId, name])
  @@map("customers")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String?   @db.Uuid
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  employee     Employee?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("users")
}

model Employee {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @db.Uuid
  userId         String?        @unique @db.Uuid
  employeeNumber String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  jobTitle       String?
  employmentType EmploymentType @default(FULL_TIME)
  startDate      DateTime?
  endDate        DateTime?
  notes          String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  workOrderAssignments WorkOrderAssignment[]

  @@unique([companyId, employeeNumber])
  @@index([companyId, isActive])
  @@index([companyId, lastName, firstName])
  @@map("employees")
}

enum WorkOrderStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model WorkOrder {
  id             String            @id @default(uuid()) @db.Uuid
  companyId      String            @db.Uuid
  customerId     String            @db.Uuid
  reference      String
  title          String
  description    String?
  status         WorkOrderStatus   @default(DRAFT)
  priority       WorkOrderPriority @default(NORMAL)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  addressLine    String?
  postalCode     String?
  city           String?
  countryCode    String            @default("BE")
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignments  WorkOrderAssignment[]
  invoiceLinks InvoiceWorkOrder[]

  @@unique([companyId, reference])
  @@index([companyId, status])
  @@index([companyId, scheduledStart])
  @@index([customerId])
  @@map("work_orders")
}

model WorkOrderAssignment {
  workOrderId String   @db.Uuid
  employeeId  String   @db.Uuid
  assignedAt  DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@id([workOrderId, employeeId])
  @@index([employeeId])
  @@map("work_order_assignments")
}

model WorkOrderSequence {
  companyId  String @db.Uuid
  year       Int
  lastNumber Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, year])
  @@map("work_order_sequences")
}

// An invoice is editable only while it is a draft.
// Overdue is calculated from dueDate instead of being stored.
enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PAID
}

model Invoice {
  id         String        @id @default(uuid()) @db.Uuid
  companyId  String        @db.Uuid
  customerId String        @db.Uuid
  number     String?
  status     InvoiceStatus @default(DRAFT)

  issueDate          DateTime?
  dueDate            DateTime?
  servicePeriodStart DateTime?
  servicePeriodEnd   DateTime?

  currencyCode String @default("EUR")
  languageCode String @default("NL")

  customerReference String?
  paymentReference  String?
  paymentTerms      String?
  notes             String?

  // Seller snapshot preserves what appeared on the issued invoice.
  sellerName        String
  sellerVatNumber   String?
  sellerEmail       String?
  sellerPhone       String?
  sellerAddressLine String?
  sellerPostalCode  String?
  sellerCity        String?
  sellerCountryCode String  @default("BE")
  sellerIban        String?
  sellerBic         String?

  // Customer snapshot prevents later customer edits from changing history.
  buyerName        String
  buyerVatNumber   String?
  buyerEmail       String?
  buyerPhone       String?
  buyerAddressLine String?
  buyerPostalCode  String?
  buyerCity        String?
  buyerCountryCode String  @default("BE")

  subtotalExclVat Decimal @default(0) @db.Decimal(12, 2)
  vatTotal        Decimal @default(0) @db.Decimal(12, 2)
  totalInclVat    Decimal @default(0) @db.Decimal(12, 2)

  sentAt DateTime?
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      InvoiceItem[]
  workOrders InvoiceWorkOrder[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, dueDate])
  @@index([customerId, issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id        String @id @default(uuid()) @db.Uuid
  invoiceId String @db.Uuid
  position  Int

  description String

  // HUR is the standard unit code for hours.
  unitCode String  @default("HUR")
  quantity Decimal @db.Decimal(12, 3)

  unitPriceExclVat   Decimal @db.Decimal(12, 2)
  discountPercentage Decimal @default(0) @db.Decimal(5, 2)

  lineSubtotalExclVat Decimal @db.Decimal(12, 2)
  vatRate             Decimal @default(21.00) @db.Decimal(5, 2)
  vatAmount           Decimal @db.Decimal(12, 2)
  lineTotalInclVat    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, position])
  @@index([invoiceId])
  @@map("invoice_items")
}

// Connects multiple completed work orders to one invoice.
model InvoiceWorkOrder {
  invoiceId   String   @db.Uuid
  workOrderId String   @db.Uuid
  linkedAt    DateTime @default(now())

  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@id([invoiceId, workOrderId])
  // V1 permits a work order to be invoiced only once.
  @@unique([workOrderId])
  @@map("invoice_work_orders")
}

// Allocates sequential invoice numbers independently for each company and year.
model InvoiceSequence {
  companyId  String @db.Uuid
  year       Int
  lastNumber Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, year])
  @@map("invoice_sequences")
}
