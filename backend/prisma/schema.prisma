generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  COMPANY_OWNER
  COMPANY_ADMIN
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  FLEXI_JOB
  STUDENT
  CONTRACTOR
  OTHER
}

model Company {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  vatNumber   String?
  email       String?
  phone       String?
  addressLine String?
  postalCode  String?
  city        String?
  countryCode String   @default("BE")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  customers Customer[]
  employees Employee[]

  @@map("companies")
}

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  name          String
  contactPerson String?
  email         String?
  phone         String?
  vatNumber     String?
  addressLine   String?
  postalCode    String?
  city          String?
  countryCode   String   @default("BE")
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive])
  @@index([companyId, name])
  @@map("customers")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String?   @db.Uuid
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  employee     Employee?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("users")
}

model Employee {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @db.Uuid
  userId         String?        @unique @db.Uuid
  employeeNumber String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  jobTitle       String?
  employmentType EmploymentType @default(FULL_TIME)
  startDate      DateTime?
  endDate        DateTime?
  notes          String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([companyId, employeeNumber])
  @@index([companyId, isActive])
  @@index([companyId, lastName, firstName])
  @@map("employees")
}
