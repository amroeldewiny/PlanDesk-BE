generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  COMPANY_OWNER
  COMPANY_ADMIN
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  FLEXI_JOB
  STUDENT
  CONTRACTOR
  OTHER
}

model Company {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  vatNumber   String?
  email       String?
  phone       String?
  addressLine String?
  postalCode  String?
  city        String?
  countryCode String   @default("BE")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              User[]
  customers          Customer[]
  employees          Employee[]
  workOrders         WorkOrder[]
  workOrderSequences WorkOrderSequence[]

  @@map("companies")
}

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  name          String
  contactPerson String?
  email         String?
  phone         String?
  vatNumber     String?
  addressLine   String?
  postalCode    String?
  city          String?
  countryCode   String   @default("BE")
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]

  @@index([companyId, isActive])
  @@index([companyId, name])
  @@map("customers")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String?   @db.Uuid
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  employee     Employee?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("users")
}

model Employee {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @db.Uuid
  userId         String?        @unique @db.Uuid
  employeeNumber String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  jobTitle       String?
  employmentType EmploymentType @default(FULL_TIME)
  startDate      DateTime?
  endDate        DateTime?
  notes          String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  workOrderAssignments WorkOrderAssignment[]

  @@unique([companyId, employeeNumber])
  @@index([companyId, isActive])
  @@index([companyId, lastName, firstName])
  @@map("employees")
}

enum WorkOrderStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model WorkOrder {
  id             String            @id @default(uuid()) @db.Uuid
  companyId      String            @db.Uuid
  customerId     String            @db.Uuid
  reference      String
  title          String
  description    String?
  status         WorkOrderStatus   @default(DRAFT)
  priority       WorkOrderPriority @default(NORMAL)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  addressLine    String?
  postalCode     String?
  city           String?
  countryCode    String            @default("BE")
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignments WorkOrderAssignment[]

  @@unique([companyId, reference])
  @@index([companyId, status])
  @@index([companyId, scheduledStart])
  @@index([customerId])
  @@map("work_orders")
}

model WorkOrderAssignment {
  workOrderId String   @db.Uuid
  employeeId  String   @db.Uuid
  assignedAt  DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@id([workOrderId, employeeId])
  @@index([employeeId])
  @@map("work_order_assignments")
}

model WorkOrderSequence {
  companyId  String @db.Uuid
  year       Int
  lastNumber Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, year])
  @@map("work_order_sequences")
}
